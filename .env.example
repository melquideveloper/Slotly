# PostgreSQL - usuário administrativo (utilizado na inicialização do container)
POSTGRES_USER=slotly_admin
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE

# Banco de dados
DB_NAME=slotly
DB_PORT=5432

# Usuário de execução da aplicação (permissões de CRUD, sem CREATE de objetos)
DB_USERNAME=slotly_app
DB_PASSWORD=SUBSTITUA_POR_OUTRA_SENHA_FORTE

# Usuário exclusivo do Flyway (criação/alteração de objetos e histórico de migrations)
MIGRATOR_USERNAME=slotly_migrator
MIGRATOR_PASSWORD=SUBSTITUA_POR_MAIS_UMA_SENHA_FORTE

# Origens autorizadas para chamadas CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200
